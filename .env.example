# Приклад кореневого .env для docker-стеку. Скопіюйте у .env і заповніть значення.
# Реальний .env у git НЕ потрапляє (див. .gitignore).

# Пароль користувача PostgreSQL. Має збігатися з паролем, яким ініціалізовано том БД.
POSTGRES_PASSWORD=beauty

# Ключ підпису JWT. Мінімум 32 байти (256 біт) — інакше сервер не стартує.
# Згенерувати: openssl rand -base64 48
JWT_KEY=

# Пароль адміна. Застосовується лише при першому заповненні порожньої БД.
ADMIN_PASSWORD=

# Сіль для хешування OTP-кодів. Згенерувати: openssl rand -base64 24
CODE_SALT=
